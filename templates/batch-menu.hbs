<section class="lumenn-batch-content">
  <header class="lumenn-batch-summary">
    <div>
      <strong>{{localize "lumenn-lightweight.dialog.scanTitle"}}</strong>
      <span>{{localize
          "lumenn-lightweight.dialog.scanMessage"
          count=assets.length
        }}</span>
    </div>
    <div class="lumenn-summary-badges">
      {{#each formats as |entry|}}
        <span class="lumenn-format-badge" data-format="{{entry.format}}">
          {{entry.format}} {{entry.count}}
        </span>
      {{/each}}
      <span class="lumenn-webp-skipped">
        <i class="fa-solid fa-check"></i>
        {{localize "lumenn-lightweight.dialog.webpSkipped"}}
      </span>
      <span class="lumenn-quality-badge">WebP {{qualityPercent}}%</span>
    </div>
  </header>

  {{#if assets.length}}
    <nav
      class="lumenn-category-tabs"
      aria-label="{{localize 'lumenn-lightweight.dialog.categories'}}"
    >
      {{#each groups as |group|}}
        <button
          type="button"
          class="lumenn-category-tab {{#if group.active}}active{{/if}}"
          data-action="filterGroup"
          data-group="{{group.key}}"
          aria-selected="{{group.active}}"
          {{#unless group.count}}disabled{{/unless}}
        >
          <i class="{{group.icon}}"></i>
          <span>{{group.label}}</span>
          <strong>{{group.count}}</strong>
        </button>
      {{/each}}
    </nav>

    <div class="lumenn-asset-list">
      {{#each groups as |group|}}
        <section
          class="lumenn-group-panel"
          data-group="{{group.key}}"
          {{#unless group.active}}hidden{{/unless}}
        >
          <header class="lumenn-group-header">
            <span><i class="{{group.icon}}"></i> {{group.label}} · {{group.count}}</span>
            <span class="lumenn-group-actions">
              <button
                type="button"
                data-action="selectGroup"
                data-group="{{group.key}}"
              >{{localize "lumenn-lightweight.dialog.selectAll"}}</button>
              <button
                type="button"
                data-action="clearGroup"
                data-group="{{group.key}}"
              >{{localize "lumenn-lightweight.dialog.clearAll"}}</button>
            </span>
          </header>

          <div class="lumenn-group-items">
            {{#each group.assets as |asset|}}
              <div class="checkbox lumenn-asset-row">
                <input
                  type="checkbox"
                  name="assets"
                  id="l_asset_{{asset.index}}"
                  value="{{asset.index}}"
                  checked
                />
                <label for="l_asset_{{asset.index}}" title="{{asset.imgPath}}">
                  <span class="lumenn-asset-name-line">
                    <span>{{asset.name}}</span>
                    <strong
                      class="lumenn-format-badge"
                      data-format="{{asset.format}}"
                    >{{asset.format}}</strong>
                  </span>
                  <small>{{asset.imgPath}}</small>
                </label>
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>

    <footer class="lumenn-batch-footer">
      <div class="lumenn-progress" hidden>
        <div class="progress-bar"><div
            class="progress-fill"
            style="width: 0%"
          ></div></div>
        <span class="progress-text"></span>
      </div>
      <button type="button" class="lumenn-batch-btn" data-action="optimize">
        <i class="fas fa-compress-alt"></i>
        {{localize "lumenn-lightweight.dialog.batchOptimize"}}
      </button>
    </footer>
  {{else}}
    <p class="notification info">{{localize
        "lumenn-lightweight.dialog.noAssets"
      }}</p>
  {{/if}}
</section>
